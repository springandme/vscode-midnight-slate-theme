    {
      "name": "Function argument",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "parameter.variable"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#D19A66",
      "italic": false
    },
    "property.declaration": {
      "foreground": "#A9B7C6"
